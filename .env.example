# Phase 3's live run needs credentials. Easiest: your own API key below. Copy this file to .env
# (git-ignored; never commit it). Alternatives need no key in a file: run `ant auth login`, or
# configure workload identity federation. No credentials at all: use `make phase3-demo-stub`.
ANTHROPIC_API_KEY=your-api-key-here

# Which model to use. Default is the cheapest current model (a whole demo costs cents).
#   PHASE3_PRESET=cheap       claude-haiku-5-5   $0.10 / $0.50 per million tokens  (default)
#   PHASE3_PRESET=balanced    claude-sonnet-5-5  $2 / $10
#   PHASE3_PRESET=best        claude-opus-5-5    $4 / $20
# PHASE3_PRESET=cheap
#
# Or name any model for every agent, or just one role (trusted, rogue, advisor). Most specific wins.
# PHASE3_MODEL=claude-sonnet-5-5
# PHASE3_MODEL_ROGUE=claude-opus-5-5
#
# Optional. low | medium | high | xhigh | max (omit for the model's default)
# PHASE3_EFFORT=low
